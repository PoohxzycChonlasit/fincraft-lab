DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/fincraft_lab?schema=public"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"

# Local Super Admin Bootstrap (run: pnpm run seed:admin)
# Required — do NOT commit actual credentials
FINCRAFT_ADMIN_EMAIL="admin@example.com"
FINCRAFT_ADMIN_PASSWORD="replace-with-a-secure-password"
# Optional — defaults to "Super Admin"
FINCRAFT_ADMIN_DISPLAY_NAME="Super Admin"
